---
// Google-Bewertungen – Texte bitte durch echte Bewertungen aus Google Maps ersetzen
const bewertungen = [
  {
    name: 'Lisa M.',
    initial: 'L',
    farbe: 'bg-blue-500',
    text: 'Mega Fahrschule! Von Anfang an war alles super organisiert. Kein Simulator-Zwang, einfach direkt loslegen. Habe meinen Führerschein auf Anhieb bestanden!',
    datum: 'vor 2 Monaten',
  },
  {
    name: 'Tobias S.',
    initial: 'T',
    farbe: 'bg-green-600',
    text: 'Das Prime-Paket ist sein Geld absolut wert. Keine versteckten Kosten, alles transparent. Dass Wiederholungsprüfungen inklusive sind, hat mir so viel Stress genommen.',
    datum: 'vor 1 Monat',
  },
  {
    name: 'Anna K.',
    initial: 'A',
    farbe: 'bg-purple-600',
    text: 'Endlich eine Fahrschule ohne böse Überraschungen. Volker und das ganze Team nehmen sich wirklich Zeit. Die Atmosphäre ist super angenehm. Klare Empfehlung!',
    datum: 'vor 3 Monaten',
  },
];
---

<section class="py-14 md:py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Kopf mit Google-Bewertung -->
    <div class="text-center mb-10 reveal">
      <span class="badge mb-4 inline-block">Google Bewertungen</span>
      <h2 class="abschnitt-titel mb-6">Das sagen unsere Fahrschüler</h2>

      <!-- Bewertungs-Badge -->
      <a
        href="https://share.google/IazG1qUHAZlkUAXxk"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-4 bg-white border border-schiefer-200 rounded-2xl px-6 py-4 shadow-sm hover:shadow-md transition-shadow"
      >
        <svg class="w-8 h-8 flex-shrink-0" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
          <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
          <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
          <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
        </svg>
        <div class="text-left">
          <div class="flex items-baseline gap-2">
            <span class="font-display font-900 text-3xl text-blau-900">4,9</span>
            <span class="text-schiefer-400 text-sm">/ 5</span>
          </div>
          <div class="flex items-center gap-1 my-1">
            {[1,2,3,4,5].map(() => (
              <svg class="w-4 h-4 text-yellow-400" viewBox="0 0 20 20" fill="currentColor">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>
          <p class="text-schiefer-500 text-xs">114 Bewertungen auf Google</p>
        </div>
      </a>
    </div>

    <!-- Bewertungs-Karten -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-10">
      {bewertungen.map(({ name, initial, farbe, text, datum }) => (
        <div class="karte reveal flex flex-col gap-4">
          <div class="flex items-center gap-3">
            <div class={`w-10 h-10 rounded-full flex-shrink-0 flex items-center justify-center text-white font-display font-800 text-base ${farbe}`}>
              {initial}
            </div>
            <div>
              <p class="font-display font-700 text-blau-900 text-sm">{name}</p>
              <p class="text-schiefer-400 text-xs">{datum}</p>
            </div>
            <!-- Google Icon -->
            <svg class="w-5 h-5 ml-auto flex-shrink-0" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
            </svg>
          </div>
          <!-- 5 Sterne -->
          <div class="flex gap-0.5">
            {[1,2,3,4,5].map(() => (
              <svg class="w-4 h-4 text-yellow-400" viewBox="0 0 20 20" fill="currentColor">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>
          <p class="text-schiefer-600 text-sm leading-relaxed flex-1">{text}</p>
        </div>
      ))}
    </div>

    <!-- CTA zu Google -->
    <div class="text-center reveal">
      <a
        href="https://share.google/IazG1qUHAZlkUAXxk"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-6 py-3 bg-blau-900 text-white font-display font-700 text-sm uppercase tracking-wider rounded-lg hover:bg-blau-800 transition-colors"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
          <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
          <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
          <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
        </svg>
        Alle Bewertungen auf Google lesen
      </a>
    </div>

  </div>
</section>
