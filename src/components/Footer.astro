---
// Fusszeile mit Adresse, Links und Zitat
---

<footer class="bg-blau-900 text-schiefer-300">
  <!-- Hauptbereich -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">

      <!-- Logo und Slogan -->
      <div>
        <a href="/" class="inline-flex items-center gap-3 mb-5 group">
          <div class="h-12 w-12 rounded-full overflow-hidden flex-shrink-0">
            <img src="/images/logo-v3.gif" alt="Fahrschule V3. Logo" class="h-full w-full object-cover object-center" />
          </div>
          <span class="font-display font-700 text-white text-lg group-hover:text-gelb-400 transition-colors">Fahrschule GmbH</span>
        </a>
        <p class="text-schiefer-400 text-sm leading-relaxed">
          Das innovative Original seit 2008.<br />
          Größte Einzelfahrschule der Region.
        </p>
        <p class="mt-4 text-schiefer-500 text-xs italic leading-relaxed border-l-2 border-gelb-400 pl-3">
          "Nachahmung ist die höchste Form der Anerkennung" (Oscar Wilde).<br />
          Oft kopiert, doch nie erreicht.
        </p>
      </div>

      <!-- Kontakt und Adresse -->
      <div>
        <h3 class="font-display font-700 text-white text-base mb-4 uppercase tracking-wide">
          Kontakt
        </h3>
        <address class="not-italic space-y-2 text-sm text-schiefer-400">
          <p>
            <span class="text-schiefer-300 font-medium">Adresse:</span><br />
            Lange Straße 41<br />
            77652 Offenburg<br />
            <span class="text-schiefer-500 text-xs">(direkt neben der Post im Zentrum)</span>
          </p>
          <p class="pt-2">
            <span class="text-schiefer-300 font-medium">Sprechzeit Inhaber:</span><br />
            Dienstag 14:00 bis 18:00 Uhr
          </p>
          <p>
            <a
              href="https://wa.me/491735324092"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-green-400 hover:text-green-300 transition-colors"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              +49 173 5324092
            </a>
          </p>
          <p>
            <a
              href="mailto:v3.volker@gmail.com"
              class="text-schiefer-400 hover:text-schiefer-200 transition-colors"
            >
              v3.volker@gmail.com
            </a>
          </p>
        </address>
      </div>

      <!-- Navigation und Anmeldung -->
      <div>
        <h3 class="font-display font-700 text-white text-base mb-4 uppercase tracking-wide">
          Schnelllinks
        </h3>
        <nav aria-label="Footer-Navigation" class="space-y-2 text-sm">
          <a href="/autofuehrerschein" class="block text-schiefer-400 hover:text-white transition-colors">Autoführerschein B197</a>
          <a href="/preise" class="block text-schiefer-400 hover:text-white transition-colors">Preise und Tarife</a>
          <a href="/anhaenger" class="block text-schiefer-400 hover:text-white transition-colors">Anhängerführerschein</a>
          <a href="/faq" class="block text-schiefer-400 hover:text-white transition-colors">Häufige Fragen</a>
          <a href="/karriere" class="block text-schiefer-400 hover:text-white transition-colors">Karriere bei V3.</a>
        </nav>

        <div class="mt-6">
          <a
            href="/#anmeldung"
            class="inline-flex items-center gap-2 px-5 py-2.5 bg-gelb-400 text-blau-900 font-display font-700 text-sm rounded-lg hover:bg-gelb-500 transition-colors"
          >
            Jetzt online anmelden
          </a>
        </div>
      </div>

    </div>
  </div>

  <!-- Unterzeile mit Rechtslinks -->
  <div class="border-t border-blau-700/50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-schiefer-600 text-xs">
        &copy; {new Date().getFullYear()} Fahrschule V3. GmbH, Offenburg
      </p>
      <nav aria-label="Rechtliche Links" class="flex flex-wrap gap-4 text-xs text-schiefer-500">
        <a href="/impressum" class="hover:text-schiefer-300 transition-colors">Impressum</a>
        <a href="/datenschutz" class="hover:text-schiefer-300 transition-colors">Datenschutz</a>
        <a href="/widerruf" class="hover:text-schiefer-300 transition-colors">Widerruf</a>
      </nav>
    </div>
  </div>
</footer>
