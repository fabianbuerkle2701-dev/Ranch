---
// Sticky Header mit Navigation und mobilem Hamburger-Menue
const navigation = [
  { label: 'Start', href: '/' },
  { label: 'Autoführerschein', href: '/autoführerschein' },
  { label: 'Preise', href: '/preise' },
  { label: 'Anhänger', href: '/anhaenger' },
  { label: 'FAQ', href: '/faq' },
  { label: 'Karriere', href: '/karriere' },
];

// Aktive Seite ermitteln
const aktuellePfad = Astro.url.pathname;
const istAktiv = (href: string) =>
  href === '/' ? aktuellePfad === '/' : aktuellePfad.startsWith(href);
---

<header
  id="kopfzeile"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
>
  <!-- Hauptleiste -->
  <div id="kopfzeile-hintergrund" class="border-b-2 transition-all duration-400">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">

        <!-- Logo -->
        <a
          href="/"
          class="flex items-center gap-2.5 group flex-shrink-0"
          aria-label="Fahrschule V3. GmbH Startseite"
        >
          <div class="h-10 w-10 rounded-full overflow-hidden flex-shrink-0">
            <img src="/images/logo-v3.gif" alt="Fahrschule V3. Logo" class="h-full w-full object-cover object-center" />
          </div>
          <div class="flex flex-col leading-tight">
            <span class="text-white font-display font-700 text-sm group-hover:text-gelb-400 transition-colors">
              Fahrschule V3.
            </span>
            <span class="text-schiefer-400 text-xs">GmbH · Offenburg</span>
          </div>
        </a>

        <!-- Desktop-Navigation -->
        <nav class="hidden lg:flex items-center gap-1" aria-label="Hauptnavigation">
          {
            navigation.map(({ label, href }) => (
              <a
                href={href}
                class={`px-3 py-2 rounded-lg text-sm font-medium transition-colors ${
                  istAktiv(href)
                    ? 'bg-gelb-400 text-blau-900'
                    : 'text-schiefer-200 hover:text-white hover:bg-blau-700'
                }`}
                aria-current={istAktiv(href) ? 'page' : undefined}
              >
                {label}
              </a>
            ))
          }
        </nav>

        <!-- Rechte Seite: Desktop-Aktionen + Mobile-CTA + Hamburger -->
        <div class="flex items-center gap-2">
          <!-- WhatsApp (nur Desktop) -->
          <a
            href="https://wa.me/491735324092"
            target="_blank"
            rel="noopener noreferrer"
            class="hidden lg:flex items-center gap-1.5 px-3 py-2 text-sm text-schiefer-200 hover:text-white transition-colors"
            aria-label="WhatsApp Kontakt"
          >
            <svg class="w-5 h-5 text-green-400" viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
              />
            </svg>
            WhatsApp
          </a>

          <!-- Anmeldung CTA Desktop -->
          <a
            href="/#anmeldung"
            class="hidden lg:inline-flex btn-primary text-sm py-2"
          >
            Jetzt anmelden
          </a>

          <!-- Anmeldung CTA Mobile (kompakt) -->
          <a
            href="/#anmeldung"
            class="lg:hidden px-3 py-1.5 bg-gelb-400 text-blau-900 font-display font-700 text-xs uppercase tracking-wide rounded-lg hover:bg-gelb-500 transition-colors"
          >
            Anmelden
          </a>

          <!-- Hamburger-Button Mobile -->
          <button
            id="hamburger"
            type="button"
            class="lg:hidden p-2 rounded-lg text-schiefer-200 hover:text-white hover:bg-blau-700 transition-colors"
            aria-label="Menü öffnen"
            aria-expanded="false"
            aria-controls="mobiles-menue"
          >
            <svg id="hamburger-symbol" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg id="schliessen-symbol" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

      </div>
    </div>
  </div>

  <!-- Mobiles Menue -->
  <div
    id="mobiles-menue"
    class="lg:hidden hidden bg-blau-900 border-b border-blau-700"
    aria-label="Mobiles Menü"
  >
    <div class="max-w-7xl mx-auto px-4 py-4 space-y-1">
      {
        navigation.map(({ label, href }) => (
          <a
            href={href}
            class={`block px-4 py-3 rounded-lg text-base font-medium transition-colors ${
              istAktiv(href)
                ? 'bg-gelb-400 text-blau-900'
                : 'text-schiefer-200 hover:text-white hover:bg-blau-700'
            }`}
            aria-current={istAktiv(href) ? 'page' : undefined}
          >
            {label}
          </a>
        ))
      }

      <!-- Mobile Aktionen -->
      <div class="pt-4 border-t border-blau-700 flex flex-col gap-3">
        <a
          href="https://wa.me/491735324092"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 px-4 py-3 bg-green-600 text-white rounded-xl font-semibold hover:bg-green-700 transition-colors"
        >
          <svg class="w-5 h-5 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor">
            <path
              d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
            />
          </svg>
          WhatsApp schreiben
        </a>

        <a
          href="/#anmeldung"
          class="btn-primary w-full"
        >
          Jetzt anmelden
        </a>
      </div>
    </div>
  </div>
</header>

<!-- Abstand fuer Fixed Header -->
<div class="h-16"></div>

<script>
  // Hamburger-Menü umschalten
  const hamburger = document.getElementById('hamburger');
  const mobilesMenue = document.getElementById('mobiles-menue');
  const hamburgerSymbol = document.getElementById('hamburger-symbol');
  const schliessenSymbol = document.getElementById('schliessen-symbol');

  hamburger?.addEventListener('click', () => {
    const istOffen = mobilesMenue?.classList.contains('hidden') === false;
    mobilesMenue?.classList.toggle('hidden');
    hamburgerSymbol?.classList.toggle('hidden');
    schliessenSymbol?.classList.toggle('hidden');
    hamburger.setAttribute('aria-expanded', String(!istOffen));
  });

  // Menü schliessen beim Klick auf einen Link
  mobilesMenue?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobilesMenue.classList.add('hidden');
      hamburgerSymbol?.classList.remove('hidden');
      schliessenSymbol?.classList.add('hidden');
      hamburger?.setAttribute('aria-expanded', 'false');
    });
  });

  // Kopfzeile beim Scrollen abdunkeln und einfaerben
  const kopfzeile = document.getElementById('kopfzeile');
  const kopfzeileHintergrund = document.getElementById('kopfzeile-hintergrund');
  function headerAktualisieren() {
    const gescrollt = window.scrollY > 40;
    kopfzeile?.classList.toggle('shadow-lg', gescrollt);
    kopfzeileHintergrund?.classList.toggle('ist-gescrollt', gescrollt);
  }
  window.addEventListener('scroll', headerAktualisieren, { passive: true });
  headerAktualisieren();
</script>

<style>
  #kopfzeile-hintergrund {
    background-color: rgba(15, 15, 15, 0.25);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-color: rgba(255, 255, 255, 0.12);
    transition: background-color 0.35s ease, border-color 0.35s ease;
  }
  #kopfzeile-hintergrund.ist-gescrollt {
    background-color: rgba(15, 15, 15, 0.96);
    border-color: #f5a623;
  }
</style>
