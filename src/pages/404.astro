---
import Seitenlayout from '../components/Seitenlayout.astro';
---

<Seitenlayout
  title="Seite nicht gefunden"
  description="Diese Seite existiert nicht. Zurueck zur Startseite der Fahrschule V3. GmbH Offenburg."
>
  <section class="py-24 md:py-36 bg-white flex items-center">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="font-display font-900 text-8xl text-gelb-400 mb-4">404</p>
      <h1 class="font-display font-800 text-3xl md:text-4xl text-blau-900 mb-4">
        Diese Seite gibt es nicht.
      </h1>
      <p class="text-schiefer-500 text-lg mb-8">
        Die gesuchte Seite existiert leider nicht oder wurde verschoben.
        Zurück zur Startseite oder direkt zur Anmeldung.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/" class="btn-primary">Zur Startseite</a>
        <a
          href="https://www.fahrschulanmeldung.de/v3-gmbh-offenburg"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 border-2 border-blau-900 text-blau-900 font-display font-700 text-sm uppercase tracking-wider rounded-lg hover:bg-blau-900 hover:text-white transition-colors"
        >
          Jetzt anmelden
        </a>
      </div>
    </div>
  </section>
</Seitenlayout>
