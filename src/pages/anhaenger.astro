---
import Seitenlayout from '../components/Seitenlayout.astro';
import WarumV3 from '../components/WarumV3.astro';
---

<Seitenlayout
  title="Anhängerführerschein B96 und BE"
  description="Anhängerführerschein in Offenburg: B96-Schulung oder BE-Führerschein bei Fahrschule V3. GmbH. Nächster B96-Kurs am 18. Juli 2026."
>
  <!-- Seiten-Hero -->
  <section class="bg-blau-900 text-white py-16 md:py-24 border-b-4 border-gelb-400">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <span class="badge mb-4 inline-block">B96 und BE</span>
        <h1 class="font-display font-900 text-5xl md:text-6xl leading-tight mb-5">
          Anhänger sicher<br />beherrschen.
        </h1>
        <p class="text-schiefer-300 text-lg leading-relaxed">
          Wohnwagen, Pferdehänger oder großer Transporter. Welche Klasse du brauchst, hängt von
          deinem Bedarf ab. Wir helfen dir dabei.
        </p>
      </div>
    </div>
  </section>

  <!-- Welche Klasse passt? -->
  <section class="py-16 md:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 reveal">
        <h2 class="abschnitt-titel">Welche Klasse passt zu dir?</h2>
        <p class="abschnitt-untertitel mx-auto">
          Laut "Caravaning" reicht für rund 90 Prozent aller Wohnwagen die B96-Schulung.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">

        <!-- B96 Karte -->
        <div class="karte reveal flex flex-col border-t-4 border-gelb-400">
          <div class="mb-4">
            <span class="badge mb-3 inline-block">Klasse B96</span>
            <h3 class="font-display font-800 text-blau-900 text-2xl mb-2">
              Für die meisten Anhänger
            </h3>
            <p class="text-schiefer-500 text-sm leading-relaxed">
              Fahrerschulung mit Theorieteil und fahrpraktischen Übungen. Ideal für Wohnwagen,
              Pferdehänger und die meisten Freizeitanhänger.
            </p>
          </div>

          <div class="border-t border-schiefer-100 pt-4 space-y-3 text-sm flex-1">
            <div class="flex items-start gap-2">
              <svg class="w-4 h-4 text-gelb-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-schiefer-600">Gesamtdauer ca. sieben Stunden</span>
            </div>
            <div class="flex items-start gap-2">
              <svg class="w-4 h-4 text-gelb-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-schiefer-600">In der Regel an einem Samstag</span>
            </div>
            <div class="flex items-start gap-2">
              <svg class="w-4 h-4 text-gelb-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-schiefer-600">Nur ein Passfoto nötig</span>
            </div>
            <div class="flex items-start gap-2">
              <svg class="w-4 h-4 text-gelb-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-schiefer-600">Kein Erste-Hilfe-Kurs und kein Sehtest nötig</span>
            </div>
            <div class="flex items-start gap-2">
              <svg class="w-4 h-4 text-gelb-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-schiefer-600">Möglichst mit mindestens drei Teilnehmern</span>
            </div>
          </div>

          <!-- Aktueller Kurs Highlight -->
          <div class="mt-6 p-4 bg-gelb-400/10 border border-gelb-400/30 rounded-xl">
            <p class="font-display font-700 text-blau-900 text-sm mb-1">Nächster Kurs:</p>
            <p class="text-blau-900 font-semibold">18. Juli 2026, 09:00 Uhr</p>
            <p class="text-schiefer-600 text-sm">Dauer: ca. sieben Stunden</p>
            <p class="text-schiefer-600 text-sm">Preis: 275,- Euro pro Person</p>
            <p class="text-red-600 text-xs mt-1 font-medium">Begrenzte Plätze!</p>
          </div>

          <div class="mt-4">
            <a
              href="https://wa.me/491735324092"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary w-full block text-center"
            >
              Platz sichern per WhatsApp
            </a>
          </div>
        </div>

        <!-- BE Karte -->
        <div class="karte reveal flex flex-col">
          <div class="mb-4">
            <span class="inline-block px-3 py-1 bg-blau-900 text-white text-xs font-display font-700 uppercase tracking-wider rounded-full mb-3">
              Klasse BE
            </span>
            <h3 class="font-display font-800 text-blau-900 text-2xl mb-2">
              Für größere Anhänger
            </h3>
            <p class="text-schiefer-500 text-sm leading-relaxed">
              Anhänger bis 3.500 Kilogramm zulässige Gesamtmasse. In Kombination mit großem
              Zugfahrzeug bis 7.000 Kilogramm Gesamtgewicht.
            </p>
          </div>

          <div class="border-t border-schiefer-100 pt-4 space-y-3 text-sm flex-1">
            <div class="flex items-start gap-2">
              <svg class="w-4 h-4 text-blau-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-schiefer-600">Keine Theorieunterrichte und keine Theorieprüfung</span>
            </div>
            <div class="flex items-start gap-2">
              <svg class="w-4 h-4 text-blau-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-schiefer-600">Individuelle Übungsfahrstunden nach Bedarf</span>
            </div>
            <div class="flex items-start gap-2">
              <svg class="w-4 h-4 text-blau-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-schiefer-600">5 Sonderfahrstunden (3x Überland, 1x Autobahn, 1x Nacht)</span>
            </div>
            <div class="flex items-start gap-2">
              <svg class="w-4 h-4 text-blau-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-schiefer-600">Fahrprüfung, 55 Minuten Dauer</span>
            </div>
          </div>

          <!-- Was benoetigt wird -->
          <div class="mt-6 border-t border-schiefer-100 pt-4">
            <p class="text-sm font-medium text-blau-900 mb-2">Für die Beantragung benötigt:</p>
            <ul class="space-y-1.5 text-sm text-schiefer-500">
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-schiefer-400 rounded-full flex-shrink-0"></span>
                Erste-Hilfe-Kurs (Sofortmassnahmen reichen nicht mehr)
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-schiefer-400 rounded-full flex-shrink-0"></span>
                Aktueller Sehtest
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-schiefer-400 rounded-full flex-shrink-0"></span>
                Passfoto
              </li>
            </ul>
          </div>

          <div class="mt-6">
            <a
              href="https://wa.me/491735324092"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 w-full px-6 py-3 bg-blau-900 text-white font-display font-700 text-sm uppercase tracking-wider rounded-lg hover:bg-blau-800 transition-colors"
            >
              Anfragen per WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- B96/BE Infografik -->
  <section class="py-16 bg-schiefer-100">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center reveal">
      <span class="badge mb-4 inline-block">Auf einen Blick</span>
      <h2 class="abschnitt-titel mb-6">B96 oder BE: Was passt zu dir?</h2>
      <div class="rounded-2xl overflow-hidden shadow-xl border border-schiefer-200">
        <img
          src="/images/b96-be-info.png"
          alt="Informationsblatt Anhängerführerschein B96 oder BE der Fahrschule V3. GmbH Offenburg"
          class="w-full h-auto"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- Hinweis 90 Prozent -->
  <section class="py-12 bg-gelb-400">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center reveal">
      <h2 class="font-display font-800 text-2xl md:text-3xl text-blau-900 mb-4">
        Unsicher, welche Klasse du brauchst?
      </h2>
      <p class="text-blau-700 text-lg leading-relaxed mb-6">
        Schreib uns per WhatsApp. Wir helfen dir, die richtige Wahl zu treffen.
        Wunschtermin für den B96-Kurs gern per Nachricht anfragen.
      </p>
      <a
        href="https://wa.me/491735324092"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-6 py-3 bg-blau-900 text-white font-display font-700 text-sm uppercase tracking-wider rounded-lg hover:bg-blau-800 transition-colors"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        Per WhatsApp anfragen
      </a>
    </div>
  </section>
  <WarumV3 />
</Seitenlayout>
