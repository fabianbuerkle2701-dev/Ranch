---
import Seitenlayout from '../components/Seitenlayout.astro';
---

<Seitenlayout
  title="Autofuehrerschein Klasse B und B197"
  description="Fuehrerschein Klasse B197 in Offenburg: Automatik-Start, schnellere Ausbildung, voller Fuehrerschein. Keine versteckten Kosten, transparente Preise bei Fahrschule V3. GmbH."
>
  <!-- Seiten-Hero -->
  <section class="bg-blau-900 text-white py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <span class="badge mb-4 inline-block">Klasse B und B197</span>
        <h1 class="font-display font-900 text-5xl md:text-6xl leading-tight mb-5">
          Drive Easy.
        </h1>
        <p class="text-schiefer-300 text-lg leading-relaxed">
          Schalten will heute kaum noch jemand. Mit B197 ist die Ausbildung attraktiver, schneller
          und einfacher. Start auf dem Automatikfahrzeug, voller Fuehrerschein am Ende.
        </p>
      </div>
    </div>
  </section>

  <!-- B197 Ablauf -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        <div class="reveal">
          <span class="badge mb-4 inline-block">Unser Standard</span>
          <h2 class="abschnitt-titel mb-4">So laeuft die B197-Ausbildung</h2>
          <p class="text-schiefer-500 leading-relaxed mb-6">
            B197 ist die modernste Form der Fuehrerscheinausbildung. Du startest auf einem
            Automatikfahrzeug und kannst dich von der ersten Stunde an voll auf das Fahren und den
            Verkehr konzentrieren.
          </p>
          <a
            href="https://www.fahrschulanmeldung.de/v3-gmbh-offenburg"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary inline-flex"
          >
            Jetzt anmelden
          </a>
        </div>

        <!-- Ablauf-Schritte -->
        <div class="space-y-4 reveal">
          <div class="flex gap-4">
            <div class="flex-shrink-0 w-9 h-9 bg-gelb-400 text-blau-900 rounded-lg flex items-center justify-center font-display font-800 text-sm">
              1
            </div>
            <div>
              <h3 class="font-display font-700 text-blau-900 mb-1">Start auf dem Automatikwagen</h3>
              <p class="text-schiefer-500 text-sm">
                Konzentration auf den Verkehr, schnellere Fortschritte, weniger Fahrstunden im
                Schnitt.
              </p>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="flex-shrink-0 w-9 h-9 bg-gelb-400 text-blau-900 rounded-lg flex items-center justify-center font-display font-800 text-sm">
              2
            </div>
            <div>
              <h3 class="font-display font-700 text-blau-900 mb-1">12 vorgeschriebene Sonderfahrstunden</h3>
              <p class="text-schiefer-500 text-sm">
                5x Ueberlandfahrt, 4x Autobahnfahrt, 3x Beleuchtungsfahrt. Alles inklusive.
              </p>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="flex-shrink-0 w-9 h-9 bg-gelb-400 text-blau-900 rounded-lg flex items-center justify-center font-display font-800 text-sm">
              3
            </div>
            <div>
              <h3 class="font-display font-700 text-blau-900 mb-1">10 Stunden auf dem Schaltwagen</h3>
              <p class="text-schiefer-500 text-sm">
                5x Ueberland, 2x Autobahn, 3x Beleuchtung. Abschluss mit 15-minuetiger Testfahrt.
              </p>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="flex-shrink-0 w-9 h-9 bg-gelb-400 text-blau-900 rounded-lg flex items-center justify-center font-display font-800 text-sm">
              4
            </div>
            <div>
              <h3 class="font-display font-700 text-blau-900 mb-1">Pruefung auf dem Automatikwagen</h3>
              <p class="text-schiefer-500 text-sm">
                Pruefungsvorbereitung und Pruefung wieder mit dem Automatikfahrzeug. Keine
                Fehlerquellen durch Schaltfehler.
              </p>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="flex-shrink-0 w-9 h-9 bg-gelb-400 text-blau-900 rounded-lg flex items-center justify-center font-display font-800 text-sm">
              5
            </div>
            <div>
              <h3 class="font-display font-700 text-blau-900 mb-1">Voller Fuehrerschein</h3>
              <p class="text-schiefer-500 text-sm">
                Kein eingeschraenkter Automatik-Fuehrerschein. Voller vollwertiger Fuehrerschein
                Klasse B, ohne Eintrag.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Vorteile B197 -->
  <section class="py-16 md:py-20 bg-schiefer-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10 reveal">
        <h2 class="abschnitt-titel">Die Vorteile im Ueberblick</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="karte reveal">
          <div class="w-10 h-10 bg-gelb-400/20 rounded-lg flex items-center justify-center mb-3">
            <svg class="w-5 h-5 text-gelb-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <h3 class="font-display font-700 text-blau-900 mb-2">Kein Schalten beim TUeV</h3>
          <p class="text-schiefer-500 text-sm">
            Keine Fehler durch falsche Bedienung des Schaltgetriebes in der Pruefungssituation.
            Volle Konzentration auf den Verkehr.
          </p>
        </div>

        <div class="karte reveal">
          <div class="w-10 h-10 bg-gelb-400/20 rounded-lg flex items-center justify-center mb-3">
            <svg class="w-5 h-5 text-gelb-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="font-display font-700 text-blau-900 mb-2">Schnellere Ausbildung</h3>
          <p class="text-schiefer-500 text-sm">
            Ohne Schalt-Lernkurve weniger Uebungsfahrstunden im Schnitt. Mehr Zeit, den Verkehr zu
            verstehen.
          </p>
        </div>

        <div class="karte reveal">
          <div class="w-10 h-10 bg-gelb-400/20 rounded-lg flex items-center justify-center mb-3">
            <svg class="w-5 h-5 text-gelb-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
            </svg>
          </div>
          <h3 class="font-display font-700 text-blau-900 mb-2">Voller Fuehrerschein</h3>
          <p class="text-schiefer-500 text-sm">
            Kein eingeschraenkter Fuehrerschein. Keine erneute Pruefung noetig, wenn man doch
            schalten will.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- B78 Variante -->
  <section class="py-16 md:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto reveal">
        <div class="karte border-l-4 border-gelb-400">
          <span class="badge mb-3 inline-block">Alternative</span>
          <h2 class="font-display font-700 text-blau-900 text-xl mb-3">
            B78: Reine Automatikausbildung
          </h2>
          <p class="text-schiefer-600 leading-relaxed mb-4">
            Wenn reine Automatikausbildung ausreicht, ist B78 die richtige Wahl. Wenn spaeter doch
            Schalten gewuenscht wird, genuegen 10 Fahrstunden auf einem Schaltwagen plus eine
            15-minuetige Testfahrt, um den Automatik-Eintrag (SZ78) austragen zu lassen.
          </p>
          <ul class="space-y-2 text-sm text-schiefer-500">
            <li class="flex items-start gap-2">
              <span class="text-gelb-500 mt-0.5">+</span>
              Keine erneute Antragstellung oder TUeV-Pruefung noetig.
            </li>
            <li class="flex items-start gap-2">
              <span class="text-gelb-500 mt-0.5">+</span>
              Durchfuehrbar innerhalb von 1 bis 2 Tagen nach bestandener Pruefung.
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Transparenz-Abschnitt -->
  <section class="py-16 bg-blau-900 text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center reveal">
      <h2 class="font-display font-800 text-3xl md:text-4xl mb-4">
        Offenheit und Transparenz
      </h2>
      <p class="text-schiefer-300 text-lg leading-relaxed mb-8">
        Keine versteckten Kosten fuer Pruefungen, Lehrmaterial oder Simulatortraining. Was du
        zahlst, das siehst du. 24/7 alles in der App einsehbar.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/preise" class="btn-primary">Preise ansehen</a>
        <a
          href="https://www.fahrschulanmeldung.de/v3-gmbh-offenburg"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-secondary"
        >
          Jetzt anmelden
        </a>
      </div>
    </div>
  </section>
</Seitenlayout>
