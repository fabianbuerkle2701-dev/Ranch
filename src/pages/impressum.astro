---
import Seitenlayout from '../components/Seitenlayout.astro';
---

<Seitenlayout
  title="Impressum"
  description="Impressum der Fahrschule V3. GmbH, Lange Strasse 41, 77652 Offenburg. Angaben gemaess Paragraf 5 TMG."
>
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="font-display font-900 text-4xl text-blau-900 mb-8">Impressum</h1>

      <div class="prose prose-slate max-w-none space-y-8">

        <div>
          <h2 class="font-display font-700 text-blau-900 text-xl mb-3">Angaben gemaess Par. 5 TMG</h2>
          <address class="not-italic text-schiefer-600 leading-relaxed">
            <strong class="text-blau-900">V3. GmbH</strong><br />
            Fahrschule fuer alle Klassen, Ausbildungsfahrschule<br />
            Lange Strasse 41<br />
            77652 Offenburg
          </address>
        </div>

        <div>
          <h2 class="font-display font-700 text-blau-900 text-xl mb-3">Handelsregister</h2>
          <p class="text-schiefer-600">Handelsregister Freiburg unter B 707 307</p>
          <p class="text-schiefer-600">USt-IdNr: DE 279 259 140</p>
        </div>

        <div>
          <h2 class="font-display font-700 text-blau-900 text-xl mb-3">Geschaeftsfuehrer</h2>
