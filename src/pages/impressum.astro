---
import Seitenlayout from '../components/Seitenlayout.astro';
---

<Seitenlayout
  title="Impressum"
  description="Impressum der Fahrschule V3. GmbH, Lange Strasse 41, 77652 Offenburg. Angaben gemäß Paragraf 5 TMG."
>
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="font-display font-900 text-4xl text-blau-900 mb-8">Impressum</h1>

      <div class="prose prose-slate max-w-none space-y-8">

        <div>
          <h2 class="font-display font-700 text-blau-900 text-xl mb-3">Angaben gemäß Par. 5 TMG</h2>
          <address class="not-italic text-schiefer-600 leading-relaxed">
            <strong class="text-blau-900">V3. GmbH</strong><br />
            Fahrschule für alle Klassen, Ausbildungsfahrschule<br />
            Lange Straße 41<br />
            77652 Offenburg
          </address>
        </div>

        <div>
          <h2 class="font-display font-700 text-blau-900 text-xl mb-3">Handelsregister</h2>
          <p class="text-schiefer-600">Handelsregister Freiburg unter B 707 307</p>
          <p class="text-schiefer-600">USt-IdNr: DE 279 259 140</p>
        </div>

        <div>
          <h2 class="font-display font-700 text-blau-900 text-xl mb-3">Geschäftsführer</h2>
          <p class="text-schiefer-600">Volker J. Blaesius</p>
          <p class="text-schiefer-600 text-sm">
            Fahrlehrer aller Klassen seit 22. August 1985, Ausbildungsfahrlehrer, Moderator
            für Aufbauseminare ASF und Punkteabbaukurse ASP
          </p>
        </div>

        <div>
          <h2 class="font-display font-700 text-blau-900 text-xl mb-3">Kontakt</h2>
          <p class="text-schiefer-600">
            WhatsApp: <a href="https://wa.me/491735324092" class="text-blau-600 hover:underline">+49 173 5324092</a><br />
            E-Mail: <a href="mailto:v3.volker@gmail.com" class="text-blau-600 hover:underline">v3.volker@gmail.com</a>
          </p>
        </div>

        <div>
          <h2 class="font-display font-700 text-blau-900 text-xl mb-3">Aufsichtsbehoerde</h2>
          <address class="not-italic text-schiefer-600 leading-relaxed">
            Landratsamt Führerscheinstelle Ortenaukreis / Offenburg<br />
            Badstraße 20<br />
            77652 Offenburg
          </address>
        </div>

        <div>
          <h2 class="font-display font-700 text-blau-900 text-xl mb-3">Bankverbindung</h2>
          <p class="text-schiefer-600">
            Postbank Nürnberg<br />
            Kontoinhaber: Volker Jochen Blaesius<br />
            IBAN: DE05 7601 0085 0629 5498 55<br />
            BIC: PBNKDEFF
          </p>
        </div>

        <div>
          <h2 class="font-display font-700 text-blau-900 text-xl mb-3">
            Plattform der EU-Kommission zur Online-Streitbeilegung
          </h2>
          <p class="text-schiefer-600">
            Die Europäische Kommission stellt eine Plattform zur Online-Streitbeilegung (OS) bereit
            unter:
            <a
              href="https://ec.europa.eu/consumers/odr"
              target="_blank"
              rel="noopener noreferrer"
              class="text-blau-600 hover:underline"
            >
              https://ec.europa.eu/consumers/odr
