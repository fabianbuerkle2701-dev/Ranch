---
import Seitenlayout from '../components/Seitenlayout.astro';
---

<Seitenlayout
  title="Hier beginnt alles"
  description="Fahrschule V3. GmbH Offenburg: Führerschein Klasse B197, Fast Lane Theorie in 7 Tagen, keine Wartezeit, bestes Preis-Leistungs-Verhältnis der Region."
>
  <!-- Hero-Bereich mit echtem Hintergrundfoto -->
  <section class="relative text-white overflow-hidden min-h-[85vh] flex items-center">
    <!-- Hintergrundbild: Fahrschule Innenraum -->
    <div class="absolute inset-0" aria-hidden="true">
      <img
        src="/images/fahrschule-innenraum.jpeg"
        alt="Moderner Theorieraum der Fahrschule V3. GmbH Offenburg"
        class="w-full h-full object-cover object-center"
        loading="eager"
      />
      <!-- Dunkler Verlauf fuer Lesbarkeit -->
      <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/60 to-black/30"></div>
      <!-- Orangener Akzentstreifen unten -->
      <div class="absolute bottom-0 left-0 right-0 h-1 bg-gelb-400"></div>
    </div>

    <div class="relative w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 md:py-28 lg:py-36">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">

        <!-- Text links -->
        <div>
          <span class="badge mb-6 inline-block">
            Fast Lane: Theorie in nur 7 Tagen
          </span>

          <h1 class="font-display font-900 text-5xl md:text-6xl lg:text-7xl leading-tight mb-6">
            Hier beginnt<br />
            <span class="text-gelb-400">alles.</span>
          </h1>

          <p class="text-schiefer-200 text-lg md:text-xl leading-relaxed mb-8 max-w-xl">
            Volker J. Blaesius und sein Team begleiten dich sicher ans Ziel. Die größte
            Einzelfahrschule der Region, B197, keine Wartezeit und bestes Preis-Leistungs-Verhältnis.
          </p>

          <div class="flex flex-col sm:flex-row gap-4">
            <a
              href="/#anmeldung"
              class="btn-primary text-base"
            >
              Jetzt anmelden
            </a>
            <a href="/preise" class="btn-secondary text-base">
              Preise ansehen
            </a>
          </div>

          <!-- Kennzahlen -->
          <div class="mt-12 grid grid-cols-3 gap-6 border-t border-white/20 pt-8">
            <div>
              <p class="font-display font-800 text-3xl text-gelb-400">9</p>
              <p class="text-schiefer-300 text-sm mt-1">Fahrlehrerinnen und Fahrlehrer</p>
            </div>
            <div>
              <p class="font-display font-800 text-3xl text-gelb-400">7</p>
              <p class="text-schiefer-300 text-sm mt-1">Tage Theorie (Fast Lane)</p>
            </div>
            <div>
              <p class="font-display font-800 text-3xl text-gelb-400">2008</p>
              <p class="text-schiefer-300 text-sm mt-1">Das Original</p>
            </div>
          </div>
        </div>

        <!-- Volker Portrait rechts (nur Desktop) -->
        <div class="hidden lg:flex justify-end">
          <div class="relative">
            <div class="w-72 h-80 xl:w-80 xl:h-96 rounded-2xl overflow-hidden shadow-2xl border-4 border-gelb-400/30">
              <img
                src="/images/volker-portrait.jpeg"
                alt="Volker J. Blaesius, Inhaber und Geschäftsführer der Fahrschule V3. GmbH"
                class="w-full h-full object-cover object-top"
              />
            </div>
            <!-- Name-Badge über dem Portrait -->
            <div class="absolute -bottom-4 left-1/2 -translate-x-1/2 bg-gelb-400 text-blau-900 px-5 py-2 rounded-xl shadow-lg whitespace-nowrap">
              <p class="font-display font-800 text-sm">Volker J. Blaesius</p>
              <p class="text-xs font-medium opacity-80">Inhaber, Fahrlehrer seit 1985</p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Fast Lane Kurstermine -->
  <section class="py-16 md:py-24 bg-schiefer-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 reveal">
        <span class="badge mb-4 inline-block">Aktuelle Termine</span>
        <h2 class="abschnitt-titel">Fast Lane Kurse</h2>
        <p class="abschnitt-untertitel mx-auto">
          Alle 14 Theorieunterrichte in nur 7 Abenden. Einzige Fahrschule in Offenburg mit diesem
          Konzept, seit über 10 Jahren.
        </p>
      </div>

      <!-- Kurs-Tabelle -->
      <div class="reveal overflow-x-auto rounded-2xl shadow-md">
        <table class="w-full min-w-[640px] bg-white text-sm">
          <thead>
            <tr class="bg-blau-900 text-white">
              <th class="px-6 py-4 text-left font-display font-700 text-xs uppercase tracking-wider">
                Kurs
              </th>
              <th class="px-6 py-4 text-left font-display font-700 text-xs uppercase tracking-wider">
                Zeitraum
              </th>
              <th class="px-6 py-4 text-left font-display font-700 text-xs uppercase tracking-wider">
                Ablauf
              </th>
              <th class="px-6 py-4 text-left font-display font-700 text-xs uppercase tracking-wider">
                Status
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-schiefer-100">
            <tr class="hover:bg-schiefer-50 transition-colors">
              <td class="px-6 py-4 font-medium text-blau-900">Fast Lane Juli</td>
              <td class="px-6 py-4 text-schiefer-600">20. bis 29. Juli</td>
              <td class="px-6 py-4 text-schiefer-600">
                18:00 bis 19:30 Uhr und 19:40 bis 21:10 Uhr<br />
                <span class="text-xs text-schiefer-400">Je Abend zwei Themen, Wochenende frei</span>
              </td>
              <td class="px-6 py-4">
                <span class="inline-block px-2 py-1 bg-green-100 text-green-700 text-xs font-semibold rounded-full">
                  Jetzt anmelden
                </span>
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <p class="mt-4 text-center text-sm text-schiefer-500 reveal">
        Themen 1 bis 14 über die Kurstage verteilt. Weitere Termine auf Anfrage per WhatsApp.
      </p>
    </div>
  </section>

  <!-- Kernvorteile -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 reveal">
        <h2 class="abschnitt-titel">Warum V3.?</h2>
        <p class="abschnitt-untertitel mx-auto">
          Seit 2008 setzen wir Massstabe in der Fahrausbildung.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Vorteil 1 -->
        <div class="karte reveal text-center">
          <div class="w-12 h-12 bg-gelb-400/20 rounded-xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6 text-gelb-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="font-display font-700 text-blau-900 mb-2">Keine Wartezeit</h3>
          <p class="text-schiefer-500 text-sm leading-relaxed">
            Fahrstunden starten sofort nach der Anmeldung. Kein Simulator-Zwang.
          </p>
        </div>

        <!-- Vorteil 2 -->
        <div class="karte reveal text-center">
          <div class="w-12 h-12 bg-gelb-400/20 rounded-xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6 text-gelb-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
            </svg>
          </div>
          <h3 class="font-display font-700 text-blau-900 mb-2">B197 als Standard</h3>
          <p class="text-schiefer-500 text-sm leading-relaxed">
            Start auf Automatik, Konzentration auf den Verkehr, schnellere Fortschritte.
          </p>
        </div>

        <!-- Vorteil 3 -->
        <div class="karte reveal text-center">
          <div class="w-12 h-12 bg-gelb-400/20 rounded-xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6 text-gelb-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
            </svg>
          </div>
          <h3 class="font-display font-700 text-blau-900 mb-2">Transparent und fair</h3>
          <p class="text-schiefer-500 text-sm leading-relaxed">
            Keine versteckten Kosten. Preisgarantie 6 Monate ab Anmeldung.
          </p>
        </div>

        <!-- Vorteil 4 -->
        <div class="karte reveal text-center">
          <div class="w-12 h-12 bg-gelb-400/20 rounded-xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6 text-gelb-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <h3 class="font-display font-700 text-blau-900 mb-2">9er-Team</h3>
          <p class="text-schiefer-500 text-sm leading-relaxed">
            9 Fahrlehrerinnen und Fahrlehrer. Persönliche Betreuung bis zur Prüfung.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Tarif Prime Hinweis -->
  <section class="py-16 md:py-20 bg-gelb-400">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center reveal">
      <span class="inline-block px-3 py-1 bg-blau-900 text-gelb-400 text-xs font-display font-700 uppercase tracking-wider rounded-full mb-6">
        Neu: V3. Prime
      </span>
      <h2 class="font-display font-800 text-2xl sm:text-3xl md:text-4xl text-blau-900 mb-4 break-words hyphens-auto" lang="de">
        Wiederholungsprüfungen kostenlos inklusive
      </h2>
      <p class="text-blau-700 text-lg leading-relaxed mb-8 max-w-2xl mx-auto">
        Im Tarif Prime sind bis zu zwei Wiederholungsprüfungen in Theorie und in der Praxis
        kostenlos enthalten. Die Lern-App ist ebenfalls gratis dabei. Deutschlandweit kein
        vergleichbares Angebot bekannt.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/preise" class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-blau-900 text-white font-display font-700 text-sm uppercase tracking-wider rounded-lg hover:bg-blau-800 transition-colors">
          Alle Tarife vergleichen
        </a>
        <a
          href="/#anmeldung"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-transparent border-2 border-blau-900 text-blau-900 font-display font-700 text-sm uppercase tracking-wider rounded-lg hover:bg-blau-900 hover:text-white transition-colors"
        >
          Jetzt anmelden
        </a>
      </div>
    </div>
  </section>

  <!-- Motorrad-Empfehlung -->
  <section class="py-12 bg-schiefer-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 reveal">
      <div class="karte flex flex-col sm:flex-row items-start sm:items-center gap-4">
        <div class="flex-shrink-0 w-12 h-12 bg-blau-900 rounded-xl flex items-center justify-center">
          <svg class="w-6 h-6 text-gelb-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div>
          <h3 class="font-display font-700 text-blau-900 mb-1">Motorradführerschein</h3>
          <p class="text-schiefer-500 text-sm">
            V3. bietet keine eigene Motorradausbildung an. Empfohlen wird die befreundete
            <a
              href="https://bikers-school.de/"
              target="_blank"
              rel="noopener noreferrer"
              class="text-blau-600 hover:text-blau-800 font-medium underline underline-offset-2"
            >
              Bikers-School</a
            >, die den Motorradführerschein in einer Woche anbietet.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Gedenken Egon Hagedorn -->
  <section class="py-12 bg-schiefer-100">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 reveal">
      <div class="karte flex flex-col items-center text-center gap-5 border-t-4 border-schiefer-400">
        <img
          src="/images/nachruf-egon-hagedorn.jpeg"
          alt="Nachruf Egon Hagedorn, Fahrschule V3. GmbH"
          class="w-full max-w-md rounded-lg shadow-md mt-2"
        />
      </div>
    </div>
  </section>

  <!-- Anmelde- und Kontaktformular -->
  <section id="anmeldung" class="py-16 md:py-24 bg-schiefer-100">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10 reveal">
        <span class="badge mb-4 inline-block">Direkte Anmeldung</span>
        <h2 class="abschnitt-titel">Jetzt anmelden oder anfragen</h2>
        <p class="abschnitt-untertitel mx-auto">
          Schreib uns direkt. Volker antwortet persönlich, in der Regel am selben Tag.
        </p>
      </div>

      <form
        name="anmeldung"
        method="POST"
        data-netlify="true"
        data-netlify-honeypot="bot-feld"
        class="karte reveal space-y-5"
      >
        <input type="hidden" name="form-name" value="anmeldung" />
        <p class="hidden">
          <label>Nicht ausfüllen: <input name="bot-feld" /></label>
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label for="name" class="block text-sm font-medium text-blau-900 mb-1.5">
              Name <span class="text-red-500" aria-label="Pflichtfeld">*</span>
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              autocomplete="name"
              class="w-full px-4 py-3 border border-schiefer-200 rounded-lg text-blau-900 placeholder-schiefer-400 focus:outline-none focus:ring-2 focus:ring-gelb-400 focus:border-transparent transition-shadow"
              placeholder="Dein Name"
            />
          </div>
          <div>
            <label for="telefon" class="block text-sm font-medium text-blau-900 mb-1.5">
              Telefon <span class="text-red-500" aria-label="Pflichtfeld">*</span>
            </label>
            <input
              type="tel"
              id="telefon"
              name="telefon"
              required
              autocomplete="tel"
              class="w-full px-4 py-3 border border-schiefer-200 rounded-lg text-blau-900 placeholder-schiefer-400 focus:outline-none focus:ring-2 focus:ring-gelb-400 focus:border-transparent transition-shadow"
              placeholder="0173 ..."
            />
          </div>
        </div>

        <div>
          <label for="email" class="block text-sm font-medium text-blau-900 mb-1.5">
            E-Mail <span class="text-red-500" aria-label="Pflichtfeld">*</span>
          </label>
          <input
            type="email"
            id="email"
            name="email"
            required
            autocomplete="email"
            class="w-full px-4 py-3 border border-schiefer-200 rounded-lg text-blau-900 placeholder-schiefer-400 focus:outline-none focus:ring-2 focus:ring-gelb-400 focus:border-transparent transition-shadow"
            placeholder="deine@email.de"
          />
        </div>

        <div>
          <label for="interesse" class="block text-sm font-medium text-blau-900 mb-1.5">
            Ich interessiere mich für <span class="text-red-500" aria-label="Pflichtfeld">*</span>
          </label>
          <select
            id="interesse"
            name="interesse"
            required
            class="w-full px-4 py-3 border border-schiefer-200 rounded-lg text-blau-900 bg-white focus:outline-none focus:ring-2 focus:ring-gelb-400 focus:border-transparent transition-shadow"
          >
            <option value="" disabled selected>Bitte wählen...</option>
            <option value="Führerschein Klasse B / B197">Führerschein Klasse B / B197</option>
            <option value="Fast Lane Theoriekurs Juli">Fast Lane Theoriekurs Juli</option>
            <option value="Anhängerführerschein B96">Anhängerführerschein B96</option>
            <option value="Anhängerführerschein BE">Anhängerführerschein BE</option>
            <option value="Allgemeine Frage">Allgemeine Frage</option>
          </select>
        </div>

        <div>
          <label for="nachricht" class="block text-sm font-medium text-blau-900 mb-1.5">
            Nachricht
          </label>
          <textarea
            id="nachricht"
            name="nachricht"
            rows="4"
            class="w-full px-4 py-3 border border-schiefer-200 rounded-lg text-blau-900 placeholder-schiefer-400 focus:outline-none focus:ring-2 focus:ring-gelb-400 focus:border-transparent transition-shadow resize-none"
            placeholder="Fragen, Wunschtermin oder sonstiges..."
          ></textarea>
        </div>

        <div class="flex items-start gap-3">
          <input
            type="checkbox"
            id="datenschutz"
            name="datenschutz"
            required
            class="mt-1 w-4 h-4 text-gelb-400 border-schiefer-300 rounded focus:ring-gelb-400"
          />
          <label for="datenschutz" class="text-sm text-schiefer-600 leading-relaxed">
            Ich habe die
            <a href="/datenschutz" class="text-blau-600 hover:underline">Datenschutzerklärung</a>
            gelesen und stimme der Verarbeitung meiner Daten zu.
            <span class="text-red-500" aria-label="Pflichtfeld">*</span>
          </label>
        </div>

        <button
          type="submit"
          class="w-full sm:w-auto btn-primary"
        >
          Absenden
        </button>
      </form>
    </div>
  </section>
</Seitenlayout>
