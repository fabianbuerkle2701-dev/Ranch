---
import Seitenlayout from '../components/Seitenlayout.astro';
---

<Seitenlayout
  title="Preise und Tarife"
  description="Transparente Preise bei Fahrschule V3. GmbH Offenburg: Tarife Select und Prime, Jubiläums-Grundbetrag, Preisgarantie 6 Monate. Kein Vergleichbares in Deutschland."
>
  <!-- Seiten-Hero -->
  <section class="bg-blau-900 text-white py-16 md:py-24 border-b-4 border-gelb-400">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <span class="badge mb-4 inline-block">Jubiläums-Angebot</span>
        <h1 class="font-display font-900 text-5xl md:text-6xl leading-tight mb-5">
          Klare Preise,<br />keine Überraschungen.
        </h1>
        <p class="text-schiefer-300 text-lg leading-relaxed">
          Preisgarantie ab Anmeldedatum 6 Monate gültig. Alle Leistungen 24/7 in der App
          einsehbar. Zahlung in vier übersichtlichen Schritten.
        </p>
      </div>
    </div>
  </section>

  <!-- Tarif-Vergleich -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 reveal">
        <h2 class="abschnitt-titel">Tarife im Vergleich</h2>
        <p class="abschnitt-untertitel mx-auto">
          Wähle den Tarif, der zu dir passt. Bitte bei der Anmeldung angeben.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-3xl mx-auto">
        <!-- Tarif Select -->
        <div class="karte reveal flex flex-col">
          <div class="mb-4">
            <span class="badge mb-3 inline-block">Tarif Select</span>
            <div class="flex items-end gap-2 mb-1">
              <span class="font-display font-900 text-4xl text-blau-900">200</span>
              <span class="text-schiefer-400 text-lg mb-1">,- Euro</span>
            </div>
            <p class="text-schiefer-500 text-sm">Grundbetrag (Jubiläums-Angebot)</p>
          </div>

          <div class="border-t border-schiefer-100 pt-4 flex-1">
            <ul class="space-y-3 text-sm text-schiefer-600">
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 text-gelb-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                Funktioniert wie in jeder anderen Fahrschule üblich
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 text-gelb-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                Attraktive Leistungen zu attraktivem Preis
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 text-gelb-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                Preisgarantie 6 Monate
              </li>
            </ul>
          </div>

          <div class="mt-6">
            <a
              href="/#anmeldung"
              class="block w-full text-center px-6 py-3 border-2 border-blau-900 text-blau-900 font-display font-700 text-sm uppercase tracking-wider rounded-lg hover:bg-blau-900 hover:text-white transition-colors"
            >
              Select wählen
            </a>
          </div>
        </div>

        <!-- Tarif Prime (hervorgehoben) -->
        <div class="karte reveal border-2 border-gelb-400 flex flex-col relative">
          <div class="absolute -top-3 left-1/2 -translate-x-1/2">
            <span class="bg-gelb-400 text-blau-900 px-4 py-1 rounded-full text-xs font-display font-800 uppercase tracking-wider whitespace-nowrap">
              Empfohlen
            </span>
          </div>

          <div class="mb-4 mt-2">
            <span class="badge mb-3 inline-block">Tarif Prime</span>
            <div class="flex items-end gap-2 mb-1">
              <span class="font-display font-900 text-4xl text-blau-900">500</span>
              <span class="text-schiefer-400 text-lg mb-1">,- Euro</span>
            </div>
            <p class="text-schiefer-500 text-sm">Grundbetrag (Jubiläums-Angebot)</p>
          </div>

          <div class="border-t border-schiefer-100 pt-4 flex-1">
            <ul class="space-y-3 text-sm text-schiefer-600">
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 text-gelb-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                Rundum-sorglos-Paket
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 text-gelb-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span><strong>Lern-App kostenlos</strong> enthalten</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 text-gelb-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>Vorstellung zu <strong>allen Prüfungen</strong> inklusive</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 text-gelb-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>Bis zu <strong>zwei Wiederholungen Theorie</strong> kostenlos</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 text-gelb-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>Bis zu <strong>zwei Wiederholungen Praxis</strong> kostenlos</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 text-gelb-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                Deutschlandweit kein vergleichbares Angebot bekannt
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 text-gelb-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                Preisgarantie 6 Monate
              </li>
            </ul>
          </div>

          <div class="mt-6">
            <a
              href="/#anmeldung"
              class="btn-primary w-full block text-center"
            >
              Prime wählen
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Fahrstunden-Preise -->
  <section class="py-16 md:py-20 bg-schiefer-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10 reveal">
        <h2 class="abschnitt-titel">Fahrstunden-Preise</h2>
        <p class="abschnitt-untertitel mx-auto">
          Alle Preise klar und transparent. Eine Fahrstunde sind immer 45 Minuten.
        </p>
      </div>

      <div class="max-w-2xl mx-auto reveal overflow-x-auto rounded-2xl shadow-md">
        <table class="w-full bg-white text-sm">
          <thead>
            <tr class="bg-blau-900 text-white">
              <th class="px-6 py-4 text-left font-display font-700 text-xs uppercase tracking-wider">
                Leistung
              </th>
              <th class="px-6 py-4 text-right font-display font-700 text-xs uppercase tracking-wider">
                Preis
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-schiefer-100">
            <tr class="hover:bg-schiefer-50 transition-colors">
              <td class="px-6 py-4 text-blau-900 font-medium">
                Übungsfahrstunde (45 Minuten)
              </td>
              <td class="px-6 py-4 text-right text-schiefer-600 font-semibold">65,- Euro</td>
            </tr>
            <tr class="hover:bg-schiefer-50 transition-colors">
              <td class="px-6 py-4 text-blau-900">
                <span class="text-xs text-schiefer-500 block">
                  Anzahlung bei Beginn der Fahrausbildung (15 Fahrstunden)
                </span>
                Paket 15 Übungsfahrstunden
              </td>
              <td class="px-6 py-4 text-right text-schiefer-600 font-semibold">975,- Euro</td>
            </tr>
            <tr class="hover:bg-schiefer-50 transition-colors">
              <td class="px-6 py-4 text-blau-900 font-medium">
                Sonderfahrstunde (45 Minuten)
              </td>
              <td class="px-6 py-4 text-right text-schiefer-600 font-semibold">65,- Euro</td>
            </tr>
            <tr class="hover:bg-schiefer-50 transition-colors">
              <td class="px-6 py-4 text-blau-900">
                <span class="text-xs text-schiefer-500 block">
                  Anzahlung bei Beginn der Sonderfahrten (12 Sonderfahrstunden)
                </span>
                Paket 12 Sonderfahrstunden
              </td>
              <td class="px-6 py-4 text-right text-schiefer-600 font-semibold">780,- Euro</td>
            </tr>
            <tr class="hover:bg-schiefer-50 transition-colors">
              <td class="px-6 py-4 text-blau-900 font-medium">
                Wechselgebuehr (Wechsel von anderer Fahrschule)
              </td>
              <td class="px-6 py-4 text-right text-schiefer-600 font-semibold">100,- Euro</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Externe Kosten -->
  <section class="py-16 md:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mx-auto">
        <div class="text-center mb-10 reveal">
          <h2 class="abschnitt-titel">Externe Kosten</h2>
          <p class="abschnitt-untertitel mx-auto">
            Diese Kosten entstehen bei externen Anbietern und werden nicht von V3. berechnet.
          </p>
        </div>

        <div class="reveal overflow-x-auto rounded-2xl shadow-md">
          <table class="w-full bg-white text-sm">
            <thead>
              <tr class="bg-schiefer-700 text-white">
                <th class="px-6 py-4 text-left font-display font-700 text-xs uppercase tracking-wider">
                  Leistung
                </th>
                <th class="px-6 py-4 text-right font-display font-700 text-xs uppercase tracking-wider">
                  Kosten
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-schiefer-100">
              <tr class="hover:bg-schiefer-50 transition-colors">
                <td class="px-6 py-4 text-schiefer-700">Sehtest</td>
                <td class="px-6 py-4 text-right text-schiefer-600">ab 6,43 Euro (gratis z. B. bei Fielmann)</td>
              </tr>
              <tr class="hover:bg-schiefer-50 transition-colors">
                <td class="px-6 py-4 text-schiefer-700">Passfoto</td>
                <td class="px-6 py-4 text-right text-schiefer-600">je nach Anbieter</td>
              </tr>
              <tr class="hover:bg-schiefer-50 transition-colors">
                <td class="px-6 py-4 text-schiefer-700">Erste-Hilfe-Kurs</td>
                <td class="px-6 py-4 text-right text-schiefer-600">je nach Anbieter</td>
              </tr>
              <tr class="hover:bg-schiefer-50 transition-colors">
                <td class="px-6 py-4 text-schiefer-700">Führerscheinstelle (BF17-Antrag)</td>
                <td class="px-6 py-4 text-right text-schiefer-600">57,- Euro plus 11,- Euro je weitere Begleitperson</td>
              </tr>
              <tr class="hover:bg-schiefer-50 transition-colors">
                <td class="px-6 py-4 text-schiefer-700">TÜV Theorieprüfung</td>
                <td class="px-6 py-4 text-right text-schiefer-600">24,99 Euro (auch bei Wiederholung)</td>
              </tr>
              <tr class="hover:bg-schiefer-50 transition-colors">
                <td class="px-6 py-4 text-schiefer-700">TÜV Fahrprüfung</td>
                <td class="px-6 py-4 text-right text-schiefer-600">129,83 Euro (auch bei Wiederholung)</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <!-- Zahlungsplan -->
  <section class="py-16 md:py-20 bg-schiefer-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10 reveal">
        <h2 class="abschnitt-titel">Zahlung in 4 Schritten</h2>
        <p class="abschnitt-untertitel mx-auto">
          Bar oder Überweisung. Alle Leistungen 24/7 in der App einsehbar.
        </p>
      </div>

      <div class="max-w-2xl mx-auto space-y-4 reveal">
        {[
          { nr: 1, titel: 'Grundbetrag', text: 'Nach der Anmeldung. Tarif Select: 200,- Euro. Tarif Prime: 500,- Euro.' },
          { nr: 2, titel: 'Anzahlung Übungsfahrstunden', text: 'Zu Beginn der Fahrausbildung, aktuell 975,- Euro (15 Stunden).' },
          { nr: 3, titel: 'Anzahlung Sonderfahrstunden', text: 'Zu Beginn der Sonderfahrten, aktuell 780,- Euro (12 Stunden).' },
          { nr: 4, titel: 'Abschlussrechnung', text: 'Vor der Fahrprüfung mit Verrechnung. Ein etwaiges Guthaben wird ausbezahlt.' },
        ].map(({ nr, titel, text }) => (
          <div class="flex gap-4 karte">
            <div class="flex-shrink-0 w-10 h-10 bg-gelb-400 text-blau-900 rounded-xl flex items-center justify-center font-display font-800 text-lg">
              {nr}
            </div>
            <div>
              <h3 class="font-display font-700 text-blau-900 mb-1">{titel}</h3>
              <p class="text-schiefer-500 text-sm">{text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-gelb-400">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center reveal">
      <h2 class="font-display font-800 text-3xl md:text-4xl text-blau-900 mb-4">
        Bereit für deinen Führerschein?
      </h2>
      <p class="text-blau-700 text-lg mb-8">
        Bitte bei der Anmeldung angeben, ob du Select oder Prime möchtest.
      </p>
      <a
        href="/#anmeldung"
        class="inline-flex items-center justify-center gap-2 px-8 py-3 bg-blau-900 text-white font-display font-700 text-sm uppercase tracking-wider rounded-lg hover:bg-blau-800 transition-colors"
      >
        Jetzt online anmelden
      </a>
    </div>
  </section>
</Seitenlayout>
